import './Header-Estudiante.css'
import { useState } from 'react'
import { useNavigate, useLocation } from 'react-router-dom'
import { obtenerSesion } from '../../data/cuentas'

const ENLACES = [
  { texto: 'Catálogo', ruta: '/catalogo' },
  { texto: 'Mis solicitudes', ruta: '/estudiante/mis-solicitudes' },
  { texto: 'Mis reservas', ruta: '/estudiante/mis-reservas' },
  { texto: 'Calendario', ruta: '/estudiante/calendario' }
]

function primeraPalabra(texto) {
  return (texto || '').trim().split(/\s+/)[0] || ''
}

function HeaderEstudiante() {
  const navigate = useNavigate()
  const { pathname } = useLocation()
  const [codigo, setCodigo] = useState('')

  // Se lee en cada render para que el nombre se actualice al editar el perfil
  const sesion = obtenerSesion()
  const nombre = primeraPalabra(sesion?.nombres)
  const apellidoPaterno = primeraPalabra(sesion?.apellidos)

  const nombreCompleto = `${nombre} ${apellidoPaterno}`.trim() || 'Estudiante'
  const iniciales =
    `${nombre.charAt(0)}${apellidoPaterno.charAt(0)}`.toUpperCase() || 'E'

  const buscar = (e) => {
    e.preventDefault()
    const texto = codigo.trim()
    navigate(texto ? `/catalogo?q=${encodeURIComponent(texto)}` : '/catalogo')
  }

  return (
    <header className="header-estudiante">
      <nav className="hdr-est-nav">
        <button
          type="button"
          className="hdr-est-logo"
          onClick={() => navigate('/catalogo')}
        >
          <span className="hdr-est-cuadro"></span>
          <span>Almacén de Equipos</span>
        </button>

        {ENLACES.map((enlace) => (
          <button
            key={enlace.ruta}
            type="button"
            className={
              pathname === enlace.ruta
                ? 'hdr-est-enlace hdr-est-enlace-activo'
                : 'hdr-est-enlace'
            }
            onClick={() => navigate(enlace.ruta)}
          >
            {enlace.texto}
          </button>
        ))}

        <form className="hdr-est-buscador" onSubmit={buscar} role="search">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-3.5-3.5" />
          </svg>
          <input
            type="text"
            aria-label="Buscar por código"
            placeholder="Buscar por código: INV-OSC-0042"
            value={codigo}
            onChange={(e) => setCodigo(e.target.value)}
          />
        </form>

        <button
          type="button"
          className="hdr-est-usuario"
          onClick={() => navigate('/cuenta')}
        >
          <span className="hdr-est-nombre">{nombreCompleto}</span>
          <span className="hdr-est-avatar">{iniciales}</span>
        </button>
      </nav>
    </header>
  )
}

export default HeaderEstudiante