const {chromium}=require('C:/Users/ferca/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright')
const assert=require('node:assert/strict')
;(async()=>{
 const browser=await chromium.launch({channel:'msedge',headless:true})
 const page=await browser.newPage({viewport:{width:1440,height:1000}})
 page.setDefaultTimeout(15000); console.log('Browser iniciado'); const errors=[];page.on('pageerror',e=>errors.push(e.message))
 await page.goto('http://127.0.0.1:5174/catalogo'); console.log('Catálogo cargado');await page.getByRole('heading',{name:'Catálogo de equipos'}).waitFor()
 assert.equal(await page.locator('.header-visitante').count(),1)
 await page.locator('.catalogo-card').first().click();await page.waitForURL('**/visitante/cata/*')
 await page.evaluate(()=>{
 const correo='20260001@aloe.ulima.edu.pe'
 localStorage.setItem('cuentasRegistradas',JSON.stringify([{nombres:'Ana',apellidos:'Pérez',correo,carrera:'Ingeniería de Sistemas',contrasena:'prueba',rol:'estudiante',bloqueada:false,deuda:{monto:15}}]))
 localStorage.setItem('almacen_equipos_encargados',JSON.stringify([{nombres:'Elena',apellidos:'Rivas',correo:'encargada@ulima.edu.pe',contrasena:'prueba',almacen:'Almacén H-102'}]))
 localStorage.setItem('sesionActual',JSON.stringify({correo:'encargada@ulima.edu.pe',rol:'encargado',almacen:'Almacén H-102'}))
 localStorage.setItem('rol','encargado')
 const fecha=new Date().toISOString().slice(0,10)
 localStorage.setItem('solicitudes',JSON.stringify([{codigo:'SOL-0001',correo,productoId:1,equipo:'Kit de robótica Arduino Mega',fecha,desde:fecha,hasta:fecha,estado:'Entregada'}]))
 localStorage.setItem('prestamos',JSON.stringify([{codigo:'PRE-2026-0001',solicitud:'SOL-0001',correo,productoId:1,equipo:'Kit de robótica Arduino Mega',unidad:'INV-ARD-0010',desde:fecha,hasta:'2020-01-01',estado:'Entregado',entrega:{fechaEntrega:fecha,accesorios:[]}}]))
 })
 for(const ruta of ['inventario','aprobacion-entrega','prestamos-vigentes','lista-espera','metricas','ranking','usuarios','reservas']){
  console.log('Revisando',ruta); await page.goto('http://127.0.0.1:5174/encargado/'+ruta);await page.locator('.ope-menu').waitFor()
  assert.equal(await page.locator('.he').count(),1,ruta)
  await page.screenshot({path:'tmp/'+ruta+'.png',fullPage:true})
 }
 await page.goto('http://127.0.0.1:5174/encargado/usuarios')
 await page.getByRole('button',{name:'Bloquear cuenta',exact:true}).click()
 await page.getByRole('dialog').getByRole('button',{name:'Bloquear cuenta',exact:true}).click()
 await page.getByRole('alert').filter({hasText:'préstamo entregado sin devolver'}).waitFor()
 await page.evaluate(()=>{const ps=JSON.parse(localStorage.getItem('prestamos'));ps[0].estado='Devuelto';ps[0].devolucion={diasRetraso:1,fechaRetorno:new Date().toISOString().slice(0,10)};localStorage.setItem('prestamos',JSON.stringify(ps))})
 await page.reload();await page.getByRole('button',{name:'Bloquear cuenta',exact:true}).click()
 await page.getByRole('dialog').getByRole('button',{name:'Bloquear cuenta',exact:true}).click()
 await page.getByRole('status').filter({hasText:'Cuenta bloqueada.'}).waitFor()
 assert.equal(await page.evaluate(()=>JSON.parse(localStorage.getItem('cuentasRegistradas'))[0].bloqueada),true)
 await page.getByRole('button',{name:'Desbloquear',exact:true}).click();await page.getByRole('status').filter({hasText:'Habilitado'}).waitFor()
 await page.getByRole('link',{name:'Ver historial',exact:true}).click();await page.waitForURL('**/encargado/historial?*');await page.locator('.hs-titulo').waitFor()
 await page.evaluate(()=>{localStorage.setItem('sesionActual',JSON.stringify({correo:'20260001@aloe.ulima.edu.pe',rol:'estudiante'}));localStorage.setItem('rol','estudiante')})
 await page.goto('http://127.0.0.1:5174/catalogo');assert.equal(await page.locator('.header-visitante').count(),0)
 await page.locator('.catalogo-card').first().click();await page.waitForURL('**/catalogo/*')
 await page.goto('http://127.0.0.1:5174/estudiante/calendario?equipo=1')
 await page.getByRole('button',{name:'Mes siguiente',exact:true}).click()
 await page.locator('button.calendario-dia').nth(0).click();await page.locator('button.calendario-dia').nth(1).click()
 await page.getByRole('button',{name:'Reservar este rango',exact:true}).click()
 await page.getByRole('dialog',{name:'Reservar equipo'}).waitFor()
 await page.getByRole('dialog').getByRole('button',{name:'Reservar',exact:true}).click()
 assert.equal(await page.evaluate(()=>JSON.parse(localStorage.getItem('reservas')).filter(r=>!r.cancelada).length),1)
 await page.goto('http://127.0.0.1:5174/estudiante/mis-reservas');await page.getByRole('heading',{name:'Mis reservas',exact:true}).waitFor();assert.equal(await page.locator('tbody tr').count(),1)
 await page.goto('http://127.0.0.1:5174/encargado/reservas');assert.equal(await page.locator('tbody tr').count(),1)
 await page.goto('http://127.0.0.1:5174/login');await page.getByLabel('Correo institucional',{exact:true}).fill('encargada@ulima.edu.pe');await page.getByLabel('Contraseña',{exact:true}).fill('prueba');await page.getByRole('button',{name:'Ingresar',exact:true}).click();await page.waitForURL('**/encargado/inventario')
 assert.equal(errors.length,0,errors.join('\n'))
 console.log('PASS: catálogo visitante, navegación de 8 páginas, header/menú, bloqueo rechazado, bloqueo exitoso, desbloqueo e historial. Reserva del calendario, Mis reservas, catálogo de estudiante e ingreso de encargado con @ulima.edu.pe. Sin errores de navegador.')
 await browser.close()
})().catch(e=>{console.error(e);process.exit(1)})




